# Working directory for generated artifacts and temporary files
LLM_WORKING_FOLDER=llm_working_folder

# LLM configuration. Keep real values only in a local .env file.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=

# Caldera configuration. Required only for Caldera-based scenarios.
CALDERA_SERVER=
CALDERA_API_KEY=

# Optional local web and FTP server configuration.
WEB_SERVER_PORT=8800
FTP_SERVER_ADDRESS=
FTP_SERVER_USER=
FTP_SERVER_PASS=

# Optional scenario data sources. Add trusted URLs locally before running related scenarios.
CISA_KEV_URL=
EDR_TELEMETRY_URL=
EDR_TELEMETRY_README_URL=
TECHNIQUE_REPORT_URL=
ADVERSARY_REPORT_URL=
