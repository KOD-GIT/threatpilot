# Working directory for LLM artifacts and temporary files
LLM_WORKING_FOLDER=llm_working_folder

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Caldera Server Configuration (Required for CALDERA scenarios)
CALDERA_SERVER=http://localhost:8888
CALDERA_API_KEY=your_caldera_api_key_here

# Optional: Integrated Web and FTP server configuration (for payload hosting & exfiltration demos)
WEB_SERVER_PORT=8800
FTP_SERVER_ADDRESS=127.0.0.1:2100
FTP_SERVER_USER=user
FTP_SERVER_PASS=12345
